# name: test/sql/drain_parse.test
# description: drain_parse table macro
# group: [drain3]

require drain3

statement ok
CREATE TABLE logs AS SELECT * FROM (VALUES
 (6, 'user carol logged in from 10.9.8.7 after 2 attempts'),
 (1, 'user alice logged in from 10.0.0.1 after 3 attempts'),
 (2, 'user bob logged in from 10.0.0.7 after 1 attempts'),
 (3, 'connection closed by peer 10.1.1.1'),
 (4, NULL),
 (5, 'connection closed by peer 10.1.1.2')) t(ts, message);

query IITT
SELECT ts, cluster_id, template, params FROM drain_parse('logs', 'message', order_by := 'ts');
----
1	1	user <*> logged in from <*> after <*> attempts	[alice, 10.0.0.1, 3]
2	1	user <*> logged in from <*> after <*> attempts	[bob, 10.0.0.7, 1]
3	2	connection closed by peer <*>	[10.1.1.1]
4	NULL	NULL	NULL
5	2	connection closed by peer <*>	[10.1.1.2]
6	1	user <*> logged in from <*> after <*> attempts	[carol, 10.9.8.7, 2]

# All input columns are kept.
query I
SELECT count(*) FROM (DESCRIBE FROM drain_parse('logs', 'message', order_by := 'ts')) WHERE column_name IN ('ts', 'message', 'cluster_id', 'template', 'params');
----
5

# Default order is scan order.
query I
SELECT first(ts) FROM drain_parse('logs', 'message');
----
6

# Views work, and so do configuration parameters.
statement ok
CREATE VIEW recent AS SELECT * FROM logs WHERE ts >= 3;

query IT
SELECT ts, template FROM drain_parse('recent', 'message', order_by := 'ts', masks := [{'pattern': '\d+\.\d+\.\d+\.\d+', 'mask': '<IP>'}]);
----
3	connection closed by peer <IP>
4	NULL
5	connection closed by peer <IP>
6	user carol logged in from <IP> after 2 attempts

query I
SELECT count(DISTINCT cluster_id) FROM drain_parse('logs', 'message', order_by := 'ts', sim_threshold := 1.0);
----
5

# Empty input.
query I
SELECT count(*) FROM drain_parse('recent', 'message') WHERE false;
----
0

statement ok
CREATE TABLE empty_logs (ts INT, message VARCHAR);

query I
SELECT count(*) FROM drain_parse('empty_logs', 'message', order_by := 'ts');
----
0

# Unknown table / column.
statement error
FROM drain_parse('nope', 'message');
----
nope

statement error
FROM drain_parse('logs', 'nope');
----
empty set of columns

# Large input, trained in order on one thread while DuckDB runs with several.
statement ok
SET threads = 4;

statement ok
CREATE TABLE big AS SELECT i AS ln, CASE i % 3 WHEN 0 THEN 'req ' || i || ' ok in ' || (i % 97) || 'ms' WHEN 1 THEN 'cache miss key=' || (i * 7) ELSE 'worker ' || (i % 13) || ' heartbeat' END AS message FROM range(300000) t(i);

query II
SELECT count(*), count(DISTINCT cluster_id) FROM drain_parse('big', 'message', order_by := 'ln');
----
300000	3

# drain_parse ids equal drain_train's model clusters.
query I
SELECT count(*) FROM drain_parse('big', 'message', order_by := 'ln') p, (SELECT drain_train(message ORDER BY ln) AS m FROM big) t WHERE drain_match(t.m, p.message).cluster_id IS DISTINCT FROM p.cluster_id;
----
0

# Without ORDER BY, threads train partial models that are merged: sizes still add up.
query II
SELECT len(c), list_sum([x.size for x in c]) FROM (SELECT drain_clusters(drain_train(message)) AS c FROM big);
----
3	300000

query II
SELECT len(r.cluster_ids), len(list_filter(r.cluster_ids, lambda x: x IS NULL)) FROM (SELECT drain_train_ids(message) AS r FROM big);
----
300000	0
