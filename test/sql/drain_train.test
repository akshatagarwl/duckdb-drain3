# name: test/sql/drain_train.test
# description: drain_train / drain_train_ids aggregates
# group: [drain3]

require drain3

statement ok
CREATE TABLE logs AS SELECT * FROM (VALUES
 (1, 'user alice logged in from 10.0.0.1 after 3 attempts'),
 (2, 'user bob logged in from 10.0.0.7 after 1 attempts'),
 (3, 'connection closed by peer 10.1.1.1'),
 (4, NULL),
 (5, 'connection closed by peer 10.1.1.2'),
 (6, 'user carol logged in from 10.9.8.7 after 2 attempts')) t(ts, message);

# The model is a BLOB with a versioned magic prefix.
query T
SELECT drain_train(message ORDER BY ts)[1:8] = 'DRAIN3M\x01'::BLOB FROM logs;
----
true

query IIT
SELECT c.cluster_id, c.size, c.template FROM (SELECT unnest(drain_clusters(drain_train(message ORDER BY ts))) AS c FROM logs) ORDER BY 1;
----
1	3	user <*> logged in from <*> after <*> attempts
2	2	connection closed by peer <*>

# NULL messages are skipped by drain_train and get a NULL id in drain_train_ids.
query TTT
SELECT r.cluster_ids, r.templates, r.sizes FROM (SELECT drain_train_ids(message ORDER BY ts) AS r FROM logs);
----
[1, 1, 2, NULL, 2, 1]	[user <*> logged in from <*> after <*> attempts, connection closed by peer <*>]	[3, 2]

# Empty input and all-NULL input give NULL.
query T
SELECT drain_train(message) FROM logs WHERE false;
----
NULL

query T
SELECT drain_train(NULL::VARCHAR) FROM range(3);
----
NULL

query T
SELECT drain_train_ids(message) FROM logs WHERE false;
----
NULL

# GROUP BY trains one independent model per group.
query IT
SELECT ts % 2 AS g, len(drain_clusters(drain_train(message ORDER BY ts))) FROM logs GROUP BY g ORDER BY g;
----
0	1
1	2

# Named parameters.
query T
SELECT c.template FROM (SELECT unnest(drain_clusters(drain_train(message, masks := [{'pattern': '\d+\.\d+\.\d+\.\d+', 'mask': '<IP>'}] ORDER BY ts))) AS c FROM logs) ORDER BY c.cluster_id;
----
user <*> logged in from <IP> after <*> attempts
connection closed by peer <IP>

query I
SELECT len(drain_clusters(drain_train(message, sim_threshold := 1.0 ORDER BY ts))) FROM logs;
----
5

query I
SELECT len(drain_clusters(drain_train(message, max_clusters := 1 ORDER BY ts))) FROM logs;
----
1

query T
SELECT c.template FROM (SELECT unnest(drain_clusters(drain_train(m, extra_delimiters := ['='] ORDER BY i))) AS c FROM (VALUES (1, 'k=1 v=a'), (2, 'k=2 v=b')) t(i, m));
----
k <*> v <*>

query T
SELECT c.template FROM (SELECT unnest(drain_clusters(drain_train(m, param_str := '{}' ORDER BY i))) AS c FROM (VALUES (1, 'job 1 done'), (2, 'job 2 done')) t(i, m));
----
job {} done

# Order matters for Drain; with ORDER BY the result is deterministic.
query T
SELECT drain_train(message ORDER BY ts) = drain_train(message ORDER BY ts) FROM logs;
----
true

# Bad parameters fail at bind time.
statement error
SELECT drain_train(message, depth := 2) FROM logs;
----
depth must be >= 3

statement error
SELECT drain_train(message, sim_threshold := 1.5) FROM logs;
----
sim_threshold must be in [0, 1]

statement error
SELECT drain_train(message, max_children := 0) FROM logs;
----
max_children must be >= 1

statement error
SELECT drain_train(message, max_clusters := -1) FROM logs;
----
max_clusters must be >= 0

statement error
SELECT drain_train(message, masks := [{'pattern': '(', 'mask': '<X>'}]) FROM logs;
----
invalid masking regex

statement error
SELECT drain_train(message, masks := [{'pattern': NULL, 'mask': '<X>'}]) FROM logs;
----
non-NULL pattern and mask

statement error
SELECT drain_train(message, param_str := 'a b') FROM logs;
----
param_str

statement error
SELECT drain_train(message, extra_delimiters := ['']) FROM logs;
----
extra_delimiters must not contain ''

statement error
SELECT drain_train(message, sim_threshold := ts) FROM logs;
----
must be a constant
